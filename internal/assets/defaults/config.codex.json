{
  "schema_version": 1,
  "agent": {
    "provider": "codex",
    "timeout": "30m"
  },
  "codex": {
    "binary": "codex"
  },
  "checks": [
    {
      "name": "whitespace",
      "command": ["git", "diff", "--check"],
      "timeout": "10m"
    }
  ],
  "implementation": {
    "max_check_repairs": 3
  },
  "review": {
    "max_attempts": 3
  },
  "protected_paths": []
}
