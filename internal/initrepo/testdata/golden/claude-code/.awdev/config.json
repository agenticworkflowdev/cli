{
  "schema_version": 1,
  "agent": {
    "provider": "claude-code",
    "timeout": "30m"
  },
  "claude_code": {
    "binary": "claude"
  },
  "checks": [
    {
      "name": "whitespace",
      "command": ["git", "diff", "--check"],
      "timeout": "10m"
    }
  ],
  "review": {
    "max_attempts": 3
  },
  "protected_paths": []
}
